# Frontend environment variables (docs/08-frontend-architecture.md §4, docs/11-deployment.md §2)
# Safe to commit — contains no secrets. Copy to .env for local runs.

# true  = render from src/mocks/*.json (parallel development, no backend needed)
# false = call the live API at VITE_API_BASE_URL
VITE_USE_MOCK=true

# Backend origin. Local: http://localhost:8000. Production: your Render URL.
VITE_API_BASE_URL=http://localhost:8000
