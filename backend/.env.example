# Backend environment variables (docs/07-backend-architecture.md §5, docs/11-deployment.md §2)
# This file contains no secrets and is safe to commit. Copy it to .env for local runs.

# Path to the SQLite file produced by Dev B's seed script.
# Relative paths are resolved against the backend/ directory, never the shell's cwd.
DATABASE_PATH=./data/database/healthcare.db

# Exact origin of the deployed frontend. Never "*" in production.
CORS_ALLOWED_ORIGIN=http://localhost:5173

# "development" or "production". Gates verbose logging only — never error detail sent to clients.
ENVIRONMENT=development
