# ==================================================
# Healthcare Analytics — Environment Variable Reference
# ==================================================
# This is a safe placeholder file. It contains no secrets, and this project
# requires none (there is no paid or authenticated upstream service).
#
# Copy the relevant block into backend/.env or frontend/.env — each subsystem
# also ships its own scoped .env.example. This root file is the full reference.
# ==================================================

# --- Backend (docs/07-backend-architecture.md §5) ---
# Relative paths resolve against backend/, not the shell's working directory.
DATABASE_PATH=./data/database/healthcare.db
# Exact deployed frontend origin in production. Never "*".
CORS_ALLOWED_ORIGIN=http://localhost:5173
ENVIRONMENT=development

# --- Frontend (docs/08-frontend-architecture.md §4, docs/11-deployment.md §2) ---
# true  = render from src/mocks/*.json, no backend required
# false = call the live API at VITE_API_BASE_URL
VITE_USE_MOCK=false
VITE_API_BASE_URL=http://localhost:8000
