# ==================================================
# Healthcare Analytics — Environment Variable Placeholders
# ==================================================
# This is a safe placeholder file. It contains no secrets.
# Variables below are justified by docs/07-backend-architecture.md,
# docs/08-frontend-architecture.md, and docs/11-deployment.md.
#
# Per docs/11-deployment.md, backend/ and frontend/ will each receive
# their own .env.example during implementation (mirroring these values
# scoped to each subsystem). This root-level file documents the full
# set of variables the architecture currently requires.
# ==================================================

# --- Backend (docs/07-backend-architecture.md §5) ---
DATABASE_PATH=./data/database/healthcare.db
CORS_ALLOWED_ORIGIN=http://localhost:5173
ENVIRONMENT=development

# --- Frontend (docs/08-frontend-architecture.md §4, docs/11-deployment.md §2) ---
VITE_USE_MOCK=true
VITE_API_BASE_URL=http://localhost:8000
